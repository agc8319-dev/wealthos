# ── Required ──────────────────────────────────────────────────────────────────

# Airtable personal access token
# Settings → Developer Hub → Personal Access Tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=pat...

# Apollo.io API key
# app.apollo.io → Settings → Integrations → API
APOLLO_API_KEY=...

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional — Pipedrive ──────────────────────────────────────────────────────

# Pipedrive API token
# Settings → Personal Preferences → API
PIPEDRIVE_API_KEY=...

# Your Pipedrive subdomain (e.g. "seensafety" for seensafety.pipedrive.com)
PIPEDRIVE_DOMAIN=seensafety

# ── Optional — Gmail ──────────────────────────────────────────────────────────

# Path to the OAuth token file generated by gmail_auth.py
GMAIL_TOKEN_FILE=outreach/gmail_token.json

# Path to your Google OAuth credentials JSON (desktop app)
GMAIL_CREDENTIALS_FILE=outreach/gmail_credentials.json
